{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/inject_session_id.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit|MultiEdit|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(.claude/hooks/**)"
    ]
  },
  "worktree": { "bgIsolation": "none" }
}
